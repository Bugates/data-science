library(tidyverse)
library(ggrepel)
## NOTE: If you extracted all challenges to the same location,
## you shouldn't have to change this filename
filename <- "./data/antibiotics.csv"
## Load the data
df_antibiotics <- read_csv(filename)
df_antibiotics %>% knitr::kable()
## NOTE: If you extracted all challenges to the same location,
## you shouldn't have to change this filename
filename <- "./data/antibiotics.csv"
## Load the data
df_antibiotics <- read_csv(filename)
df_antibiotics %>% knitr::kable()
df_antibiotics <- df_antibiotics %>%
rename_with(tolower)
if ("bacteria" %in% names(df_antibiotics)) {
df_antibiotics <- df_antibiotics %>%
rename(name = bacteria)
}
df_long <- df_antibiotics %>%
pivot_longer(
cols = c(penicillin, streptomycin, neomycin),
names_to = "antibiotic",
values_to = "mic"
)
# WRITE YOUR CODE HERE
ggplot(df_long, aes(x = mic, y = name, color = gram)) +
geom_point(size = 3) +
facet_wrap(~ antibiotic) +
scale_x_log10() +
labs(
x = "Minimum inhibitory concentration (MIC)",
y = "Bacteria",
color = "Gram stain",
title = "Effectiveness of three antibiotics"
) +
theme_bw()
# WRITE YOUR CODE HERE
ggplot(df_long, aes(x = antibiotic, y = name, fill = mic)) +
geom_tile(color = "white") +
facet_wrap(~ gram, scales = "free_y") +
scale_fill_gradient(
low = "lightblue",
high = "darkblue",
trans = "log10"
) +
labs(
x = "Antibiotic",
y = "Bacteria",
fill = "MIC",
title = "Antibiotic effectiveness across bacteria"
) +
theme_bw()
# WRITE YOUR CODE HERE
ggplot(df_long, aes(x = mic, y = name, color = gram)) +
geom_point(size = 3) +
facet_wrap(~ antibiotic) +
scale_x_log10() +
labs(
x = "Minimum inhibitory concentration (MIC)",
y = "Bacteria",
color = "Gram stain",
title = "Effectiveness of three antibiotics"
) +
theme_bw()
# WRITE YOUR CODE HERE
