library(tidyverse)
df_titanic <- as_tibble(Titanic)
library(tidyverse)
df_titanic <- as_tibble(Titanic)
library(dplyr)
library(ggplot2)
df_titanic %>%
filter(
Sex == "Male",
(Class == "1st" & Age == "Adult") |
(Class == "3rd" & Age == "Child")
) %>%
mutate(
Group = case_when(
Class == "1st" & Age == "Adult" ~ "1st Class Adult Men",
Class == "3rd" & Age == "Child" ~ "3rd Class Male Children"
)
) %>%
group_by(Group) %>%
summarise(
survival_rate = sum(n[Survived == "Yes"]) / sum(n),
.groups = "drop"
) %>%
ggplot(aes(x = Group, y = survival_rate)) +
geom_col(width = 0.65) +
scale_y_continuous(
labels = scales::percent,
limits = c(0, 1)
) +
labs(
title = "Survival depended on more than age and gender",
x = NULL,
y = "Survival rate"
) +
theme_minimal()
df_titanic %>%
ggplot() +
geom_col(
aes(
x = Class,
y = n,
fill = Survived
),
position = "fill"
) +
facet_grid(Age ~ Sex) +
scale_y_continuous(
labels = scales::percent
) +
labs(
title = "Titanic survival by class, age, and sex",
x = "Class",
y = "Percentage",
fill = "Survived"
)
