library(tidyverse)
df_titanic <- as_tibble(Titanic)
## TASK: Perform a `glimpse` of df_titanic
glimpse(df_titanic)
## NOTE: No need to edit! We'll cover how to
## do this calculation in a later exercise.
df_titanic %>%
summarize(total = sum(n))
## TASK: Visualize counts against `Class` and `Sex`
df_titanic %>%
filter(Survived == "Yes") %>%
ggplot() +
geom_col(
aes(
x = Class,
y = n,
fill = Sex
)
)
df_prop %>%
filter(Survived == "Yes") %>%
ggplot() +
geom_col(
aes(
x = Class,
y = Prop,
fill = Sex
)
)
## NOTE: No need to edit! We'll cover how to
## do this calculation in a later exercise.
df_prop <-
df_titanic %>%
group_by(Class, Sex, Age) %>%
mutate(
Total = sum(n),
Prop = n / Total
) %>%
ungroup()
df_prop
df_prop %>%
filter(Survived == "Yes") %>%
ggplot() +
geom_col(
aes(
x = Class,
y = Prop,
fill = Sex
)
)
df_prop %>%
filter(Survived == "Yes") %>%
ggplot() +
geom_col(
aes(
x = Class,
y = Prop,
fill = Sex
),
position = "dodge"
) +
facet_grid(Age ~ .)
df_titanic %>%
ggplot() +
geom_col(
aes(
x = Class,
y = n,
fill = Survived
),
position = "fill"
) +
facet_grid(Age ~ Sex) +
labs(
title = "Who survived the Titanic?",
subtitle = "Survival proportion by class, sex, and age",
x = "Passenger class",
y = "Proportion",
fill = "Survived"
)
df_titanic %>%
ggplot() +
