filename <- "./data/stang.csv"
## Load the data
df_stang <- read_csv(filename)
df_stang
## TASK: Tidy `df_stang`
df_stang_long <-
df_stang %>%
pivot_longer()
## TASK: Tidy `df_stang`
df_stang_long <-
df_stang %>%
pivot_longer()
## TASK: Tidy `df_stang`
df_stang_long <-
df_stang %>%
pivot_longer()
## NOTE: No need to change this
## Names
assertthat::assert_that(
setequal(
df_stang_long %>% names,
