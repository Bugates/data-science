df_stang_long <-
df_stang %>%
pivot_longer()
## TASK: Tidy `df_stang`
df_stang_long <-
df_stang %>%
pivot_longer()
## TASK: Tidy `df_stang`
df_stang_long <-
df_stang %>%
pivot_longer(
cols = c(E_00, nu_00, E_45, nu_45, E_90, nu_90),
names_to = c(".value", "angle"),
names_sep = "_"
) %>%
mutate(angle = as.integer(angle)) %>%
filter(E > 0, nu > 0)
df_stang_long
## NOTE: No need to change this
## Names
assertthat::assert_that(
setequal(
df_stang_long %>% names,
c("thick", "alloy", "angle", "E", "nu")
)
)
## Dimensions
assertthat::assert_that(all(dim(df_stang_long) == c(26, 5)))
## Type
assertthat::assert_that(
(df_stang_long %>% pull(angle) %>% typeof()) == "integer"
)
print("Very good!")
#
df_stang_long %>%
summarize(
min_E = min(E),
max_E = max(E),
min_nu = min(nu),
max_nu = max(nu)
)
df_stang_long %>%
distinct(alloy)
df_stang_long %>%
distinct(angle)
df_stang_long %>%
distinct(thick)
df_stang_long %>%
group_by(angle) %>%
summarize(
mean_E = mean(E),
mean_nu = mean(nu)
)
