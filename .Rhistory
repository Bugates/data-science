# WRITE YOUR CODE HERE
ggplot(
df_antibiotics,
aes(x = penicillin, y = streptomycin, color = gram)
) +
geom_point(size = 3) +
geom_text_repel(aes(label = name), size = 3) +
scale_x_log10() +
scale_y_log10() +
labs(
x = "Penicillin MIC",
y = "Streptomycin MIC",
color = "Gram stain",
title = "Penicillin vs Streptomycin"
) +
theme_bw()
# WRITE YOUR CODE HERE
ggplot(
df_antibiotics,
aes(x = name, y = neomycin, fill = gram)
) +
geom_col() +
coord_flip() +
scale_y_log10() +
labs(
x = "Bacteria",
y = "Neomycin MIC",
fill = "Gram stain",
title = "Neomycin effectiveness across bacteria"
) +
theme_bw()
