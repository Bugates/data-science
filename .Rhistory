ggplot(aes(as_factor(angle), nu)) +
geom_point(size = 3) +
labs(
x = "Angle (degrees)",
y = "Poisson's ratio (nu)"
) +
theme_minimal()
## NOTE: No need to change; run this chunk
df_stang_long %>%
ggplot(aes(nu, E, color = as_factor(thick))) +
geom_point(size = 3) +
theme_minimal()
