ggplot(df_long, aes(x = antibiotic, y = mic, fill = gram)) +
geom_boxplot() +
geom_point(
position = position_jitterdodge(
jitter.width = 0.1,
dodge.width = 0.75
),
size = 2,
alpha = 0.7
) +
scale_y_log10() +
labs(
x = "Antibiotic",
y = "Minimum inhibitory concentration (MIC)",
fill = "Gram stain",
title = "Distribution of antibiotic effectiveness"
) +
theme_bw()
